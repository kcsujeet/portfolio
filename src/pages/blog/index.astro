---
import { getCollection } from "astro:content";
import SectionLabel from "@/components/SectionLabel.astro";
import PostRow from "@/features/blog/components/PostRow.astro";
import { readingTimeMinutes } from "@/features/blog/utils/reading-time";
import MainLayout from "@/layouts/MainLayout.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const grouped = new Map<number, typeof posts>();
for (const post of posts) {
  const year = post.data.pubDate.getFullYear();
  grouped.set(year, [...(grouped.get(year) ?? []), post]);
}
const years = Array.from(grouped.keys()).sort((a, b) => b - a);
---

<MainLayout
  title="Writing · Sujeet Kc"
  description="Notes on the things I build, debug, and learn."
>
  <div class="mx-auto max-w-page">
    <div class="px-gutter flex flex-wrap gap-x-12 gap-y-6 pt-index-top pb-index-bottom">
      <SectionLabel class="pt-3">writing</SectionLabel>
      <div class="flex min-w-0 grow basis-lead flex-col gap-6">
        <h1 class="m-0 text-index font-medium ">
          Notes on the things I build, debug, and learn.
        </h1>
        <p class="m-0 max-w-150 text-lede text-secondary-foreground">
          Mostly Rails, PostgreSQL, and TypeScript. Some are guides, some are
          write-ups of things that broke in production.
        </p>
      </div>
    </div>

    {
      years.map((year) => (
        <section class="px-gutter flex flex-wrap gap-x-12 gap-y-2 border-t border-border py-10">
          <SectionLabel>
            <h2 class="m-0 text-label font-normal">{year}</h2>
          </SectionLabel>
          <ol class="m-0 min-w-0 grow basis-list list-none p-0 [&>li:first-child>a]:border-t-0 [&>li:first-child>a]:pt-0">
            {grouped.get(year)?.map((post) => (
              <PostRow
                href={`/blog/${post.id}`}
                title={post.data.title}
                date={post.data.pubDate}
                minutes={readingTimeMinutes(post.body ?? "")}
                dateFormat="full"
              />
            ))}
          </ol>
        </section>
      ))
    }
    {
      posts.length === 0 && (
        <p class="px-gutter border-t border-border py-10 text-secondary-foreground">No posts yet.</p>
      )
    }
  </div>
</MainLayout>
