---
import { getCollection } from "astro:content";
import Mono from "@/components/Mono.astro";
import Reveal from "@/components/Reveal.astro";
import PostRow from "@/features/blog/components/PostRow.astro";
import { readingTimeMinutes } from "@/features/blog/utils/reading-time";
import MainLayout from "@/layouts/MainLayout.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

type GroupedPost = {
  id: string;
  title: string;
  pubDate: Date;
  tags: string[];
  body: string;
};

const grouped = new Map<number, GroupedPost[]>();
for (const post of posts) {
  const year = post.data.pubDate.getUTCFullYear();
  const list = grouped.get(year) ?? [];
  list.push({
    id: post.id,
    title: post.data.title,
    pubDate: post.data.pubDate,
    tags: post.data.tags,
    body: post.body ?? "",
  });
  grouped.set(year, list);
}

const years = Array.from(grouped.keys()).sort((a, b) => b - a);
---

<MainLayout
  title="Writing · Sujeet Kc"
  description="Notes on the things I build, debug, and learn."
>
  <div class="relative">
    <div class="max-w-3xl mx-auto px-8 pt-16 md:pt-24 pb-20">
      <a
        href="/"
        class="group inline-flex items-center gap-2 text-muted-foreground hover:text-primary transition-colors"
      >
        <span class="group-hover:-translate-x-1 transition-transform">←</span>
        <Mono>BACK</Mono>
      </a>

      <Reveal class="mt-10">
        <h1 class="text-white text-5xl md:text-6xl font-medium tracking-tight leading-none">
          Writing<span class="text-primary">.</span>
        </h1>
        <p class="mt-6 text-foreground/70 text-lg md:text-xl max-w-prose">
          Notes on the things I build, debug, and learn.
        </p>
      </Reveal>

      <div class="mt-12">
        {
          years.map((year) => (
            <section class="mt-10 first:mt-0">
              <div class="flex items-baseline gap-4 mb-2">
                <span class="block flex-1 h-px bg-border" />
                <Mono class="text-muted-foreground">{year}</Mono>
              </div>
              {grouped.get(year)!.map((post, i) => (
                <Reveal delay={i * 30}>
                  <PostRow
                    href={`/blog/${post.id}`}
                    title={post.title}
                    date={post.pubDate}
                    tags={post.tags}
                    minutes={readingTimeMinutes(post.body)}
                    dateFormat="month-day"
                  />
                </Reveal>
              ))}
            </section>
          ))
        }
        {
          posts.length === 0 && (
            <p class="text-foreground/55">No posts yet. Check back soon.</p>
          )
        }
      </div>
    </div>
  </div>
</MainLayout>
