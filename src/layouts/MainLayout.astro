---
import "../styles/global.css";
import { JOB_TITLE } from "@/config/constants";

type Props = {
  title?: string;
  description?: string;
};

const { title: pageTitle, description: pageDescription } = Astro.props;

const defaultTitle = "Sujeet Kc · Senior Full-Stack Engineer · Halifax";
const defaultOgTitle = `Sujeet Kc | ${JOB_TITLE} & Problem Solver`;
const defaultDescription = `Senior Full-Stack Engineer specializing in React, Ruby on Rails, and Astro. Focused on building high-performance, scalable web applications and solving complex architectural challenges.`;

const finalTitle = pageTitle ?? defaultTitle;
const finalOgTitle = pageTitle ?? defaultOgTitle;
const finalDescription = pageDescription ?? defaultDescription;

const logoUrl = "/logo.svg";
const siteUrl = "https://kcsujeet.com.np/";
const ogType = "website";
const ogSiteName = "Sujeet Kc | Portfolio";
const keywords =
  "Sujeet Kc, Senior Full-Stack Engineer, Software Architect, Problem Solver, React Developer, Ruby on Rails Expert, PostgreSQL, Postgres, SQL, Redis, Docker, Astro Framework, TypeScript, Web Performance, Scalable Architecture, Canada Developer, Halifax Software Engineer";

const canonicalURL = new URL(Astro.url.pathname, siteUrl);

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Sujeet Kc",
  url: siteUrl,
  sameAs: [
    "https://github.com/kcsujeet",
    "https://linkedin.com/in/kc-sujeet",
    "https://dev.to/kcsujeet",
  ],
  jobTitle: JOB_TITLE,
  worksFor: {
    "@type": "Organization",
    name: "Event Temple",
  },
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "Dalhousie University",
  },
  description: defaultDescription,
  image: new URL(logoUrl, siteUrl).href,
  knowsAbout: [
    "Full-Stack Development",
    "React",
    "Ruby on Rails",
    "PostgreSQL",
    "Postgres",
    "SQL",
    "Redis",
    "Docker",
    "Astro",
    "TypeScript",
    "System Architecture",
    "Web Performance",
  ],
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Sujeet Kc Portfolio",
  url: siteUrl,
  description: defaultDescription,
  author: "Sujeet Kc",
};

const grainSvg = `url("data:image/svg+xml;utf8,<svg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3'/></filter><rect width='100%25' height='100%25' filter='url(%23n)' opacity='0.6'/></svg>")`;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{finalTitle}</title>
    <meta name="description" content={finalDescription} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Sujeet Kc" />
    <link rel="canonical" href={canonicalURL} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Open Graph tags -->
    <meta property="og:title" content={finalOgTitle} />
    <meta property="og:description" content={finalDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL(logoUrl, siteUrl)} />
    <meta property="og:site_name" content={ogSiteName} />
    <meta property="og:locale" content="en_CA" />

    <!-- Twitter Card tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@kcsujeet" />
    <meta name="twitter:title" content={finalOgTitle} />
    <meta name="twitter:description" content={finalDescription} />
    <meta name="twitter:image" content={new URL(logoUrl, siteUrl)} />

    <link rel="icon" type="image/svg+xml" href={logoUrl} sizes="any" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify([personSchema, websiteSchema])} />
  </head>

  <body class="bg-background text-foreground font-sans">
    <!-- Atmosphere: ambient primary glows + grain. Blob positions are
         decorative absolute positioning tuned to the viewport. -->
    <div class="pointer-events-none fixed inset-0 z-0 overflow-hidden" aria-hidden="true">
      <div
        class="absolute -top-[10vh] md:-top-[20vh] left-1/2 -translate-x-1/2 w-[180vw] md:w-[120vw] h-[70vh] md:h-[90vh] rounded-full blur-3xl radial-center from-primary/35 md:from-primary/22 to-transparent to-65% md:to-60%"
      />
      <div
        class="absolute top-[55vh] md:top-[60vh] -left-[20vw] md:-left-[10vw] w-[110vw] md:w-[70vw] h-[60vh] md:h-[70vh] rounded-full blur-3xl radial-center from-primary/18 md:from-primary/10 to-transparent to-65%"
      />
      <div
        class="absolute inset-0 radial-from-bottom from-black/60 to-transparent to-75%"
      />
      <div
        class="absolute inset-0 opacity-[0.03] mix-blend-overlay"
        style={`background-image: ${grainSvg};`}
      />
    </div>

    <main class="relative z-10 min-h-screen overflow-x-clip">
      <slot />
    </main>
  </body>
</html>
