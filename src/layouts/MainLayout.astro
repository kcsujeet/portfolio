---
import "../styles/global.css";
import MobileNav from "@/components/MobileNav.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import { JOB_TITLE } from "@/config/constants";

type Props = {
  title?: string;
  description?: string;
  /** The homepage ends in the contact block, which carries its own footer. */
  home?: boolean;
};

const {
  title: pageTitle,
  description: pageDescription,
  home = false,
} = Astro.props;

const defaultTitle = "Sujeet Kc · Senior Full-Stack Engineer · Vancouver";
const defaultOgTitle = `Sujeet Kc | ${JOB_TITLE} & Problem Solver`;
const defaultDescription = `Senior full-stack engineer. Seven years of Ruby on Rails, PostgreSQL, API design, and TypeScript, building toward AWS.`;

const finalTitle = pageTitle ?? defaultTitle;
const finalOgTitle = pageTitle ?? defaultOgTitle;
const finalDescription = pageDescription ?? defaultDescription;

const logoUrl = "/logo.svg";
const siteUrl = "https://kcsujeet.com.np/";
const ogType = "website";
const ogSiteName = "Sujeet Kc | Portfolio";
const keywords =
  "Sujeet Kc, Senior Full-Stack Engineer, Backend Engineer, Ruby on Rails Developer, PostgreSQL, Postgres, SQL, REST API, JSON:API, Database Migrations, AWS, Docker, Node.js, Cloudflare Workers, D1, R2, TypeScript, React, Vancouver Software Engineer, Coquitlam Software Engineer";

const canonicalURL = new URL(Astro.url.pathname, siteUrl);

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Sujeet Kc",
  url: siteUrl,
  sameAs: [
    "https://github.com/kcsujeet",
    "https://linkedin.com/in/kc-sujeet",
    "https://dev.to/kcsujeet",
  ],
  jobTitle: JOB_TITLE,
  worksFor: {
    "@type": "Organization",
    name: "Event Temple",
  },
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "Dalhousie University",
  },
  description: defaultDescription,
  image: new URL(logoUrl, siteUrl).href,
  knowsAbout: [
    "Backend Development",
    "Ruby on Rails",
    "PostgreSQL",
    "REST API Design",
    "JSON:API",
    "Database Migrations",
    "Query Optimization",
    "Node.js",
    "Docker",
    "AWS",
    "Cloudflare Workers",
    "TypeScript",
    "React",
  ],
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Sujeet Kc Portfolio",
  url: siteUrl,
  description: defaultDescription,
  author: "Sujeet Kc",
};
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#e9ebee" />
    <title>{finalTitle}</title>
    <meta name="description" content={finalDescription} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Sujeet Kc" />
    <link rel="canonical" href={canonicalURL} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Open Graph tags -->
    <meta property="og:title" content={finalOgTitle} />
    <meta property="og:description" content={finalDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL(logoUrl, siteUrl)} />
    <meta property="og:site_name" content={ogSiteName} />
    <meta property="og:locale" content="en_CA" />

    <!-- Twitter Card tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@kcsujeet" />
    <meta name="twitter:title" content={finalOgTitle} />
    <meta name="twitter:description" content={finalDescription} />
    <meta name="twitter:image" content={new URL(logoUrl, siteUrl)} />

    <link rel="icon" type="image/svg+xml" href={logoUrl} sizes="any" />
    <!-- iOS home screen icon. https://developer.apple.com/library/archive/documentation/AppleApplications/Reference/SafariWebContent/ConfiguringWebApplications/ConfiguringWebApplications.html -->
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify([personSchema, websiteSchema])} />
  </head>

  <body class="bg-background font-sans text-foreground">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-3 focus:z-50 focus:bg-primary focus:px-4 focus:py-2 focus:text-primary-foreground"
    >
      Skip to content
    </a>
    <SiteHeader current={home ? undefined : "writing"} />
    <main id="main" class="min-h-main">
      <slot />
    </main>
    {!home && <SiteFooter />}
    <MobileNav current={home ? undefined : "writing"} />
  </body>
</html>
