---
import SectionLabel from "@/components/SectionLabel.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { EMAIL } from "@/config/constants";
---

<section id="contact" class="bg-night text-night-ink">
  <div class="px-gutter mx-auto flex max-w-[1280px] flex-wrap gap-x-12 gap-y-6 pt-[clamp(80px,11vw,120px)] pb-[clamp(64px,9vw,96px)]">
    <SectionLabel class="text-night-ink-3">06 / contact</SectionLabel>
    <div class="flex min-w-0 flex-[1_1_480px] flex-col gap-10">
      <h2 class="m-0 max-w-[820px] text-[clamp(32px,4.4vw,52px)] leading-[1.12] font-medium tracking-[-0.03em]">
        Have a problem nobody will notice once it’s solved?
      </h2>
      <a
        href={`mailto:${EMAIL}`}
        class="self-start border-b border-night-ink-3 pb-1 text-[clamp(18px,2vw,24px)] break-all hover:no-underline hover:border-night-ink"
      >
        {EMAIL}
      </a>
      <div class="flex flex-wrap gap-x-10 gap-y-3 text-[13px] text-night-ink-2">
        <span>open to backend &amp; infrastructure roles</span>
        <a href="https://github.com/kcsujeet" target="_blank" rel="noopener noreferrer" class="tap">github</a>
        <a href="https://linkedin.com/in/kc-sujeet" target="_blank" rel="noopener noreferrer" class="tap">linkedin</a>
      </div>
    </div>
  </div>
  <SiteFooter tone="night" />
</section>
