---
import SectionLabel from "@/components/SectionLabel.astro";

const FACTS: [string, string][] = [
  ["education", "M.A.C.S., Dalhousie University"],
  ["focus", "Full stack, going deeper on backend & infra"],
  ["hours", "Pacific time · remote / hybrid"],
  ["next", "AWS Developer – Associate"],
];
---

<section id="about" class="px-gutter py-section grid gap-x-12 gap-y-8 border-t border-rule md:grid-cols-about xl:grid-cols-about-wide xl:justify-between">
  <SectionLabel>02 / about</SectionLabel>
  <div class="flex max-w-155 min-w-0 flex-col gap-5.5 text-lede">
    <p class="m-0">
      I’m from Nepal, now in Coquitlam, BC. I like working across the whole
      product, from the screen people use to the database behind it.
    </p>
    <p class="m-0 text-ink-2">
      At Event Temple that has meant leading our API rewrite to JSON:API,
      building a migration engine that moved 1.5 million records without
      downtime, and co-leading the move from AngularJS to React and Next.js.
    </p>
    <p class="m-0 text-ink-2">
      Right now I’m going deeper into backend and infrastructure, and studying
      for the AWS Developer – Associate exam.
    </p>
  </div>
  <dl class="m-0 flex max-w-115 flex-col self-start border-b border-rule text-label md:col-start-2 xl:col-start-3">
    {
      FACTS.map(([k, v]) => (
        <div class="grid grid-cols-fact gap-3 border-t border-rule py-3">
          <dt class="text-ink-3">{k}</dt>
          <dd class="m-0">{v}</dd>
        </div>
      ))
    }
  </dl>
</section>
