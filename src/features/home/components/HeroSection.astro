---
import Mono from "@/components/Mono.astro";
import Reveal from "@/components/Reveal.astro";
import Button from "@/components/ui/Button.astro";
---

<section
  id="intro"
  class="pt-24 md:pt-40 pb-20 md:pb-28 min-h-[85vh] flex flex-col justify-center"
  data-screen-label="01 Home"
>
  <div class="flex items-baseline gap-6 mb-12">
    <span class="text-foreground/15 text-5xl md:text-6xl font-medium tabular-nums tracking-tight leading-none">
      01.
    </span>
    <span class="block flex-1 h-px bg-border -translate-y-2" />
    <Mono class="text-primary">INTRO</Mono>
  </div>

  <Reveal delay={120}>
    <h1 class="text-white text-7xl sm:text-8xl lg:text-9xl font-medium tracking-tighter leading-none">
      Sujeet<span class="text-foreground/45">Kc</span><span class="text-primary">.</span>
    </h1>
  </Reveal>

  <Reveal delay={220}>
    <div class="mt-12 max-w-prose space-y-4 text-lg md:text-xl">
      <p class="text-foreground/80 text-base">
        Seven years of building software end to end, and still finding new ways to enjoy it.
      </p>
    </div>
  </Reveal>

  <Reveal delay={300}>
    <div class="mt-10 flex flex-wrap items-center gap-2">
      <Button href="#projects" arrow="down">View projects</Button>
      <Button href="#contact" variant="primary" arrow="right">Let's talk</Button>
    </div>
  </Reveal>
</section>
