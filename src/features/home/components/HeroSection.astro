---
import SectionLabel from "@/components/SectionLabel.astro";
import { YEARS_IN_WORDS } from "@/config/constants";
---

<div class="px-gutter grid gap-6 pt-hero-top pb-hero-bottom">
  <SectionLabel>senior full-stack engineer</SectionLabel>
  <div class="flex min-w-0 flex-col gap-10">
    <h1 class="m-0 text-display font-medium ">
      I build the whole stack.<br />The screen, the API,<br /><span class="text-muted-foreground/85">and the data underneath.</span>
    </h1>
    <p class="m-0 max-w-150 text-lede text-secondary-foreground">
      {YEARS_IN_WORDS} years building web products end to end: React and
      Next.js on the front, Rails and PostgreSQL behind it. Lately I'm going
      deeper into infrastructure and AWS. Currently at Event Temple, remote
      from Metro Vancouver.
    </p>
  </div>
</div>
