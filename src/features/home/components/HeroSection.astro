---
import SectionLabel from "@/components/SectionLabel.astro";
import { YEARS_IN_WORDS } from "@/config/constants";
---

<div class="px-gutter flex flex-wrap gap-x-12 gap-y-6 pt-hero-top pb-hero-bottom">
  <SectionLabel class="md:pt-3.5">senior <br class="max-md:hidden" />full-stack <br class="max-md:hidden" />engineer</SectionLabel>
  <div class="flex min-w-0 grow basis-lead flex-col gap-10">
    <h1 class="m-0 text-display font-medium ">
      I build the whole stack.<br />The screen, the API,<br /><span class="text-ink-4">and the data underneath.</span>
    </h1>
    <p class="m-0 max-w-150 text-lede text-ink-2">
      {YEARS_IN_WORDS} years building web products end to end: React and
      Next.js on the front, Rails and PostgreSQL behind it. Lately I'm going
      deeper into infrastructure and AWS. Currently at Event Temple, remote
      from Coquitlam, BC.
    </p>
  </div>
</div>
