---
import { LAYERS } from "../data";

// Fig. 01: each layer below the surface sits on a darker band, so depth
// reads as a section cut through the ground.
const BAND = {
  surface: "",
  api: "band-bleed bg-strata-1",
  data: "band-bleed bg-strata-2",
  infra: "band-bleed bg-strata-3",
};
const STACK_TONE = {
  surface: "text-[oklch(0.4_0.01_250)]",
  api: "text-ink-2",
  data: "text-[oklch(0.32_0.01_250)]",
  infra: "text-[oklch(0.28_0.01_250)]",
};
const [surface, ...below] = LAYERS;
---

<figure class="px-gutter m-0 pb-[clamp(80px,10vw,120px)]">
  <figcaption class="flex flex-wrap justify-between gap-x-12 gap-y-2 pb-3 text-xs tracking-[0.1em] text-ink-3 uppercase">
    <span>fig. 01 · section through a system</span><span>what I work on</span>
  </figcaption>
  <div class="border-t border-ink">
    {
      [surface].map((row) => (
        <div class="flex flex-wrap gap-x-12 gap-y-1 border-b border-rule py-[22px]">
          <span class="flex-[0_0_200px] font-medium">{row.depth} {row.layer}</span>
          <span class="flex-[1_1_260px]">{row.line}</span>
          <span class:list={["flex-[1_1_260px]", STACK_TONE[row.layer]]}>{row.stack.join(" · ")}</span>
        </div>
      ))
    }
    <div class="flex items-center gap-3 py-2.5 text-[11px] tracking-[0.04em] whitespace-nowrap text-ink-3 sm:gap-4 sm:text-xs sm:tracking-[0.06em]" aria-hidden="true">
      <span>↑ what users see</span>
      <span class="min-w-4 flex-1 border-t border-dashed border-divider"></span>
      <span>what they depend on ↓</span>
    </div>
    {
      below.map((row) => (
        <div class:list={["flex flex-wrap gap-x-12 gap-y-1 py-[22px]", BAND[row.layer]]}>
          <span class="flex-[0_0_200px] font-medium">{row.depth} {row.layer}</span>
          <span class="flex-[1_1_260px]">{row.line}</span>
          <span class:list={["flex-[1_1_260px]", STACK_TONE[row.layer]]}>{row.stack.join(" · ")}</span>
        </div>
      ))
    }
  </div>
</figure>
