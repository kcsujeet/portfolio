---
import Mono from "@/components/Mono.astro";
import Reveal from "@/components/Reveal.astro";
import SectionHead from "@/components/SectionHead.astro";
import Badge from "@/components/ui/Badge.astro";
import { EXPERIENCE } from "../data";
---

<section data-screen-label="03 Experience">
  <SectionHead
    n="03."
    label="EXPERIENCE"
    anchor="experience"
  >
    <p>
      Seven years of API design, PostgreSQL schema and query work, and production data migrations, with frontend work alongside it.
    </p>
  </SectionHead>

  <div class="space-y-3 mt-4">
    {
      EXPERIENCE.map((item, i) => (
        <Reveal delay={i * 60}>
          <details class="group relative border border-border rounded-sm bg-card hover:border-primary/30 transition-all overflow-hidden">
            <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none radial-from-top from-primary/15 to-transparent to-60%" />
            <summary class="relative w-full text-left p-7 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
              <div class="flex items-start justify-between gap-6">
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-3 flex-wrap">
                    <Mono class="text-primary">{item.year}</Mono>
                    <span class="block w-3 h-px bg-foreground/15" />
                    <Badge variant="primary">{item.impact}</Badge>
                  </div>
                  <h3 class="mt-3 text-white text-2xl tracking-tight">
                    {item.role}
                  </h3>
                  <p class="mt-1 text-muted-foreground text-sm">
                    <span class="text-foreground">{item.company}</span>
                    <span class="mx-2 text-foreground/15">·</span>
                    {item.where}
                  </p>
                </div>
                <span class="shrink-0 mt-2 w-7 h-7 inline-flex items-center justify-center border border-foreground/15 rounded-full text-muted-foreground transition-all duration-300 group-hover:border-primary/50 group-hover:text-primary group-open:rotate-90">
                  ›
                </span>
              </div>
              <p class="mt-4 text-foreground/80 text-base max-w-prose">
                {item.summary}
              </p>
            </summary>
            <div class="details-body">
              <div>
                <div class="px-7 pb-7">
                  <ul class="space-y-3 max-w-prose">
                    {
                      item.points.map((p) => (
                        <li class="flex gap-3 text-foreground/65 text-sm leading-relaxed">
                          <span class="text-primary mt-1 shrink-0">›</span>
                          <span>{p}</span>
                        </li>
                      ))
                    }
                  </ul>
                  <div class="mt-5 flex flex-wrap gap-x-3 gap-y-2">
                    {item.stack.map((s) => <Badge>{s}</Badge>)}
                  </div>
                </div>
              </div>
            </div>
          </details>
        </Reveal>
      ))
    }
  </div>
</section>
