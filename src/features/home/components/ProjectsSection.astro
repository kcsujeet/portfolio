---
import Mono from "@/components/Mono.astro";
import Pulse from "@/components/Pulse.astro";
import Reveal from "@/components/Reveal.astro";
import SectionHead from "@/components/SectionHead.astro";
import Badge from "@/components/ui/Badge.astro";
import Card from "@/components/ui/Card.astro";

type Project = {
  id: string;
  year: string;
  title: string;
  blurb: string;
  stack: string[];
  href?: string;
  repo?: string;
  state: string[];
  featured?: boolean;
};

const PROJECTS: Project[] = [
  {
    id: "ilamy",
    year: "2026",
    title: "Ilamy Calendar",
    blurb:
      "Open-source React calendar library, now rebuilt around a tiny ~13 KB gzipped core and an opt-in plugin ecosystem, so you only ship what you use. RFC 5545 recurring events, resource scheduling, drag-and-drop, timezones, and 100+ locales. Published on npm as @ilamy/calendar.",
    stack: ["React", "TypeScript", "Tailwind CSS 4", "dnd-kit", "Motion"],
    href: "https://ilamy.dev",
    repo: "https://github.com/kcsujeet/ilamy-calendar",
    state: ["Live", "Open Source"],
    featured: true,
  },
  {
    id: "sublimeread",
    year: "2026",
    title: "SublimeRead",
    blurb:
      "An Ai reading app that narrates your EPUBs and PDFs in natural-sounding voices.",
    stack: ["Astro", "React", "TypeScript", "Cloudflare", "WASM"],
    href: "https://sublimeread.com",
    state: ["Live"],
    featured: true,
  },
  {
    id: "testoise",
    year: "2026",
    title: "Testoise",
    blurb:
      "Lightweight, fully type-safe lazy test variables for Bun, Vitest, Jest, and Node. Inspired by RSpec.",
    stack: ["TypeScript", "Bun", "Vitest", "Jest"],
    repo: "https://github.com/kcsujeet/testoise",
    state: ["Open Source"],
  },
  {
    id: "collage",
    year: "2026",
    title: "Collage Pen",
    blurb:
      "Browser-based collage maker designed to feel like a native desktop app. Custom Canvas with gesture interactions and high-resolution export.",
    stack: ["Astro", "React", "TypeScript", "Canvas API"],
    href: "https://collagepen.com",
    state: ["Live"],
  },
  {
    id: "debackground",
    year: "2026",
    title: "Debackground",
    blurb:
      "Privacy-first AI background remover that runs entirely in the browser. Transformers.js and WASM. No uploads, no waiting, everything happens locally.",
    stack: ["Transformers.js", "WASM", "TypeScript", "React"],
    href: "https://debackground.com",
    state: ["Live"],
  },
  {
    id: "fujimee",
    year: "2025",
    title: "Fujimee",
    blurb:
      "Photography platform inspired by Fujifilm film recipes. Quick access to custom presets for photographers.",
    stack: ["Astro", "Firebase", "Cloudflare", "Tailwind"],
    href: "https://fujimee.com",
    state: ["Live"],
  },
];
---

<section data-screen-label="04 Projects">
  <SectionHead n="04." label="Personal Projects" anchor="projects">
    <p>
      A curated selection of engineering projects, from open-source libraries to complex web architectures.
    </p>
  </SectionHead>

  <div class="grid md:grid-cols-2 gap-3 mt-4 md:auto-rows-fr">
    {
      PROJECTS.map((item, i) => {
        const featured = item.featured ?? false;
        const wrapperClass = ["h-full", featured && "md:col-span-2"]
          .filter(Boolean)
          .join(" ");
        return (
          <Reveal delay={i * 50} class={wrapperClass}>
            <Card
              as="a"
              href={item.href || item.repo}
              target="_blank"
              rel="noopener noreferrer"
              hover
              glow={featured ? "top-left" : "right"}
              padding={featured ? "lg" : "md"}
              class="h-full flex flex-col"
              contentClass="flex-1 flex flex-col"
            >
              <div class="flex items-start justify-between gap-6">
                <div class="flex items-center gap-3 flex-wrap">
                  <Mono class="text-muted-foreground">{item.year}</Mono>
                  <span class="block w-3 h-px bg-foreground/15" />
                  {item.state.map((s) => (
                    <span class="inline-flex items-center gap-1.5">
                      {s === "Live" && <Pulse />}
                      <Mono
                        class={
                          s === "Live"
                            ? "text-primary"
                            : "text-muted-foreground"
                        }
                      >
                        {s}
                      </Mono>
                    </span>
                  ))}
                </div>
                <span class="shrink-0 text-foreground/30 group-hover:text-primary group-hover:translate-x-1 transition-all">
                  ↗
                </span>
              </div>
              <h3
                class:list={[
                  "mt-4 text-white tracking-tight",
                  featured ? "text-2xl md:text-3xl" : "text-xl",
                ]}
              >
                {item.title}
              </h3>
              <p
                class:list={[
                  "mt-2 text-foreground/65 max-w-prose",
                  featured ? "text-base" : "text-sm",
                ]}
              >
                {item.blurb}
              </p>
              <div class="mt-auto pt-6 flex flex-wrap gap-x-3 gap-y-2">
                {item.stack.map((s) => <Badge>{s}</Badge>)}
              </div>
            </Card>
          </Reveal>
        );
      })
    }
    <Reveal delay={PROJECTS.length * 50} class="h-full">
      <a
        href="https://github.com/kcsujeet"
        target="_blank"
        rel="noopener noreferrer"
        class="group flex flex-col justify-center p-7 h-full border border-dashed border-foreground/15 rounded-sm hover:border-primary/50 transition-colors"
      >
        <Mono class="text-muted-foreground">EXPLORING MORE?</Mono>
        <p class="mt-3 text-white text-lg md:text-xl">
          Full project index on GitHub
        </p>
        <div class="mt-3 flex items-center gap-2 text-muted-foreground group-hover:text-primary transition-colors">
          <Mono>GITHUB.COM/KCSUJEET</Mono>
          <span class="group-hover:translate-x-1 transition-transform">→</span>
        </div>
      </a>
    </Reveal>
  </div>
</section>
