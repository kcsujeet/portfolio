---
import Mono from "@/components/Mono.astro";
import Pulse from "@/components/Pulse.astro";
import Reveal from "@/components/Reveal.astro";
import SectionHead from "@/components/SectionHead.astro";
import Badge from "@/components/ui/Badge.astro";
import Card from "@/components/ui/Card.astro";
import { PROJECTS } from "../data";
---

<section data-screen-label="04 Projects">
  <SectionHead n="04." label="Personal Projects" anchor="projects">
    <p>
      A selection of side projects: developer tools, open-source libraries, and apps that run on-device.
    </p>
  </SectionHead>

  <div class="grid md:grid-cols-2 gap-3 mt-4 md:auto-rows-fr">
    {
      PROJECTS.map((item, i) => {
        const featured = item.featured ?? false;
        const wrapperClass = ["h-full", featured && "md:col-span-2"]
          .filter(Boolean)
          .join(" ");
        return (
          <Reveal delay={i * 50} class={wrapperClass}>
            <Card
              as="a"
              href={item.href || item.repo}
              target="_blank"
              rel="noopener noreferrer"
              hover
              glow={featured ? "top-left" : "right"}
              padding={featured ? "lg" : "md"}
              class="h-full flex flex-col"
              contentClass="flex-1 flex flex-col"
            >
              <div class="flex items-start justify-between gap-6">
                <div class="flex items-center gap-3 flex-wrap">
                  <Mono class="text-muted-foreground">{item.year}</Mono>
                  <span class="block w-3 h-px bg-foreground/15" />
                  {item.state.map((s) => (
                    <span class="inline-flex items-center gap-1.5">
                      {s === "Live" && <Pulse />}
                      <Mono
                        class={
                          s === "Live"
                            ? "text-primary"
                            : "text-muted-foreground"
                        }
                      >
                        {s}
                      </Mono>
                    </span>
                  ))}
                </div>
                <span class="shrink-0 text-foreground/30 group-hover:text-primary group-hover:translate-x-1 transition-all">
                  ↗
                </span>
              </div>
              <h3
                class:list={[
                  "mt-4 text-white tracking-tight",
                  featured ? "text-2xl md:text-3xl" : "text-xl",
                ]}
              >
                {item.title}
              </h3>
              <p
                class:list={[
                  "mt-2 text-foreground/65 max-w-prose",
                  featured ? "text-base" : "text-sm",
                ]}
              >
                {item.blurb}
              </p>
              <div class="mt-auto pt-6 flex flex-wrap gap-x-3 gap-y-2">
                {item.stack.map((s) => <Badge>{s}</Badge>)}
              </div>
            </Card>
          </Reveal>
        );
      })
    }
    <Reveal delay={PROJECTS.length * 50} class="h-full">
      <a
        href="https://github.com/kcsujeet"
        target="_blank"
        rel="noopener noreferrer"
        class="group flex flex-col justify-center p-7 h-full border border-dashed border-foreground/15 rounded-sm hover:border-primary/50 transition-colors"
      >
        <Mono class="text-muted-foreground">EXPLORING MORE?</Mono>
        <p class="mt-3 text-white text-lg md:text-xl">
          Full project index on GitHub
        </p>
        <div class="mt-3 flex items-center gap-2 text-muted-foreground group-hover:text-primary transition-colors">
          <Mono>GITHUB.COM/KCSUJEET</Mono>
          <span class="group-hover:translate-x-1 transition-transform">→</span>
        </div>
      </a>
    </Reveal>
  </div>
</section>
