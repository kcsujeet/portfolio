---
import SectionLabel from "@/components/SectionLabel.astro";
import { PROJECTS } from "../data";
---

<section id="projects" class="px-gutter py-section flex flex-col gap-10 border-t border-border">
  <div class="flex flex-wrap items-end gap-x-12 gap-y-4">
    <SectionLabel>04 / projects</SectionLabel>
    <h2 class="m-0 grow basis-heading text-heading font-medium ">
      Things I built because I wanted them to exist.
    </h2>
  </div>
  <ul class="m-0 grid list-none grid-cols-cards gap-px border-t border-b border-t-foreground border-b-border bg-border p-0">
    {
      PROJECTS.map((p) => (
        <li class="flex">
          <a
            href={p.href}
            target="_blank"
            rel="noopener noreferrer"
            class="flex min-h-55 w-full flex-col gap-3.5 bg-background p-7 transition-colors duration-150 hover:bg-accent hover:no-underline"
          >
            <span class="flex justify-between text-xs text-muted-foreground">
              <span>{p.tag}</span>
              <span aria-hidden="true">↗</span>
            </span>
            <span class="text-xl font-medium">{p.name}</span>
            <span class="flex-1 text-sm text-secondary-foreground">{p.line}</span>
            <span class="text-xs text-muted-foreground">{p.stack.join(" · ")}</span>
          </a>
        </li>
      ))
    }
  </ul>
  <a href="https://github.com/kcsujeet" target="_blank" rel="noopener noreferrer" class="tap link self-start text-label">
    more on github.com/kcsujeet →
  </a>
</section>
