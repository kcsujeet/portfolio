---
import { type DateFormat, formatDate } from "@/features/blog/utils/format-date";

type Props = {
  href: string;
  title: string;
  date: Date;
  minutes: number;
  dateFormat?: DateFormat;
};

const { href, title, date, minutes, dateFormat = "month-year" } = Astro.props;
---

<li>
  <a
    href={href}
    class="flex flex-wrap gap-x-8 gap-y-1 border-t border-rule py-[22px] transition-colors duration-150 hover:bg-hover hover:no-underline"
  >
    <time datetime={date.toISOString()} class="flex-[0_0_100px] text-[13px] text-ink-3">
      {formatDate(date, dateFormat)}
    </time>
    <span class="flex-[1_1_300px] text-[17px]">{title}</span>
    <span class="text-[13px] text-ink-3">{minutes} min</span>
  </a>
</li>
