---
import { getCollection } from "astro:content";
import SectionLabel from "@/components/SectionLabel.astro";
import { readingTimeMinutes } from "@/features/blog/utils/reading-time";
import PostRow from "./PostRow.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const latest = posts.slice(0, 3);
---

{
  latest.length > 0 && (
    <section id="writing" class="px-gutter py-section flex flex-wrap gap-x-12 gap-y-6 border-t border-rule">
      <SectionLabel>05 / notes</SectionLabel>
      <div class="flex min-w-0 flex-[1_1_480px] flex-col">
        <ol class="m-0 list-none p-0">
          {latest.map((post) => (
            <PostRow
              href={`/blog/${post.id}`}
              title={post.data.title}
              date={post.data.pubDate}
              minutes={readingTimeMinutes(post.body ?? "")}
            />
          ))}
        </ol>
        <a href="/blog" class="border-t border-rule py-[22px] text-[13px]">all notes →</a>
      </div>
    </section>
  )
}
