---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { formatDate } from "@/features/blog/utils/format-date";
import { readingTimeMinutes } from "@/features/blog/utils/reading-time";
import { MobileToc } from "./MobileToc";

// Shape of each entry in the `headings` array returned by astro:content's
// render(): https://docs.astro.build/en/guides/markdown-content/
type Heading = { depth: number; slug: string; text: string };

type Props = {
  post: CollectionEntry<"blog">;
  headings?: Heading[];
};

const { post, headings = [] } = Astro.props;
// Only section headings make a useful contents list; h1 lives in the header.
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const minutes = readingTimeMinutes(post.body ?? "");
const formattedPubDate = formatDate(post.data.pubDate, "full");
const formattedUpdated = post.data.updatedDate
  ? formatDate(post.data.updatedDate, "full")
  : undefined;
---

<div class="px-gutter flex flex-wrap gap-x-12 gap-y-8 pt-post-top pb-section">
  <aside class="flex shrink-0 grow-0 basis-label flex-col gap-6 text-label text-muted-foreground max-post:grow max-post:basis-full">
    <a href="/blog" class="tap link self-start text-foreground">← all writing</a>
    <dl class="m-0 flex flex-col border-b border-border">
      <div class="grid grid-cols-meta gap-3 border-t border-border py-2.5">
        <dt>date</dt>
        <dd class="m-0 text-foreground"><time datetime={post.data.pubDate.toISOString()}>{formattedPubDate}</time></dd>
      </div>
      <div class="grid grid-cols-meta gap-3 border-t border-border py-2.5">
        <dt>read</dt>
        <dd class="m-0 text-foreground">{minutes} min</dd>
      </div>
      {
        post.data.tags.length > 0 && (
          <div class="grid grid-cols-meta gap-3 border-t border-border py-2.5">
            <dt>tags</dt>
            <dd class="m-0 text-foreground">{post.data.tags.join(" · ")}</dd>
          </div>
        )
      }
    </dl>

    {
      toc.length > 0 && (
        <blog-toc class="sticky top-24 hidden max-h-toc overflow-y-auto post:block">
          <nav aria-label="Table of contents">
            <p class="m-0 pb-3">on this page</p>
            <ul class="m-0 list-none border-l border-border p-0">
              {toc.map((h) => (
                <li>
                  <a
                    href={`#${h.slug}`}
                    class:list={[
                      "toc-link -ml-px block border-l border-transparent py-1 leading-snug text-muted-foreground hover:text-foreground hover:no-underline",
                      h.depth === 3 ? "pl-6" : "pl-3",
                    ]}
                  >
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </blog-toc>
      )
    }
  </aside>

  <article class="min-w-0 grow basis-lead">
    {toc.length > 0 && <MobileToc client:load headings={toc} />}

    <header>
      <h1 class="m-0 max-w-title text-headline font-medium ">
        {post.data.title}
      </h1>
      <p class="mt-6 mb-0 max-w-lede text-lede text-secondary-foreground">{post.data.description}</p>
      {
        post.data.cover && (
          <div class="mt-10 overflow-hidden border border-border">
            <Image
              src={post.data.cover as ImageMetadata}
              alt={post.data.coverAlt ?? post.data.title}
              widths={[640, 960, 1280]}
              sizes="(min-width: 768px) 768px, 100vw"
            />
          </div>
        )
      }
    </header>

    <div class="mt-12 border-t border-foreground pt-2 prose">
      <slot />
    </div>

    <footer class="mt-16 flex max-w-post flex-wrap gap-x-8 gap-y-2 border-t border-border pt-5 text-label text-muted-foreground">
      <a href="/blog" class="tap link text-foreground">← all writing</a>
      {formattedUpdated && <span>updated {formattedUpdated}</span>}
      {
        post.data.devto && (
          <a href={post.data.devto} target="_blank" rel="noopener noreferrer" class="tap link">
            originally on dev.to ↗
          </a>
        )
      }
    </footer>
  </article>
</div>

<script>
  import { watchActiveHeading } from "../utils/active-heading";

  // Marks the side contents list's link for the section the reader is in.
  class BlogToc extends HTMLElement {
    private activeLink: HTMLAnchorElement | null = null;
    private stopWatching = () => {};

    connectedCallback() {
      const links = [...this.querySelectorAll<HTMLAnchorElement>("a")];
      // The href holds the heading id as written (`#${slug}`), so it needs no
      // decoding.
      const getHeadingId = (link: HTMLAnchorElement) =>
        link.getAttribute("href")?.slice(1) ?? "";
      this.stopWatching = watchActiveHeading(links.map(getHeadingId), (id) => {
        const link = links.find((l) => getHeadingId(l) === id);
        if (!link) return;
        if (link === this.activeLink) return;
        this.activeLink?.removeAttribute("aria-current");
        link.setAttribute("aria-current", "true");
        this.activeLink = link;
      });
    }

    disconnectedCallback() {
      this.stopWatching();
    }
  }

  // Guard so a dev HMR re-run (or any double-eval) doesn't throw
  // "already defined" and abort the module. (Mobile TOC is a separate React
  // island, MobileToc.tsx, built on Base UI's Popover.)
  if (!customElements.get("blog-toc")) {
    customElements.define("blog-toc", BlogToc);
  }
</script>
