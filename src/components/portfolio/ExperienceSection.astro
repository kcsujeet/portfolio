---
import Mono from "./Mono.astro";
import Reveal from "./Reveal.astro";
import SectionHead from "./SectionHead.astro";

type ExpItem = {
  id: string;
  year: string;
  role: string;
  company: string;
  where: string;
  impact: string;
  summary: string;
  points: string[];
  stack: string[];
};

const EXPERIENCE: ExpItem[] = [
  {
    id: "et",
    year: "2023 – PRESENT",
    role: "Senior Full-Stack Engineer",
    company: "Event Temple",
    where: "Remote",
    impact: "Migration Lead",
    summary:
      "Co-led a 2-year migration from AngularJS to React/Next.js with a 2-engineer team. Owned the architecture, the patterns, and the migration strategy. Migrated the Rails API to V2 with JSON:API standards.",
    points: [
      "Built a reusable migration system that safely moves up to 1.5M records across complex relational schemas, enabling zero-downtime onboarding.",
      "Shipped Proposals and Guest Portal, contributing to $2M+ in multi-year enterprise contracts with hotel groups managing 200+ properties.",
      "Designed a 78 KB embeddable Preact widget with namespaced styles for seamless customer-site integration.",
    ],
    stack: ["Next.js", "React", "Ruby on Rails", "TypeScript", "PostgreSQL"],
  },
  {
    id: "lf",
    year: "2021 – 2022",
    role: "Front-End Developer",
    company: "Legalfit",
    where: "Remote",
    impact: "Vue 3 Migration",
    summary:
      "Led the Vue 2 to Vue 3 migration with TypeScript. Built tools for non-technical users, with clients in the room.",
    points: [
      "Standardized component patterns to improve maintainability and reduce type-related bugs.",
      "Built a drag-and-drop form builder with rich text editing, from requirements to ship.",
      "Integrated and customized Tiptap for a real-time content builder used by non-technical users.",
    ],
    stack: ["Vue 3", "TypeScript", "Django"],
  },
  {
    id: "tv",
    year: "2019 – 2021",
    role: "Software Engineer",
    company: "Tekvortex",
    where: "Lalitpur, NP",
    impact: "$500K ARR Contribution",
    summary:
      "Built backend systems in Rails and PostgreSQL. Schema design, query optimization, and a D3.js dependency-mapping system that drove product revenue.",
    points: [
      "Designed a database client for non-technical users in Angular and Ruby on Rails.",
      "Developed a D3.js dependency-mapping system that contributed to approximately $500K in annual revenue.",
    ],
    stack: ["D3.js", "Ruby on Rails", "PostgreSQL"],
  },
];
---

<section data-screen-label="03 Experience">
  <SectionHead
    n="03."
    label="PROFESSIONAL JOURNEY"
    anchor="experience"
  >
    <p>
      A track record of high-leverage migrations, performance work, and shipping customer-facing features that move revenue.
    </p>
  </SectionHead>

  <div class="space-y-3 mt-4">
    {
      EXPERIENCE.map((item, i) => (
        <Reveal delay={i * 60}>
          <details class="group relative border border-border rounded-sm bg-card hover:border-primary/30 transition-all overflow-hidden">
            <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none radial-from-top from-primary/15 to-transparent to-60%" />
            <summary class="relative w-full text-left p-7 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
              <div class="flex items-start justify-between gap-6">
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-3 flex-wrap">
                    <Mono class="text-primary">{item.year}</Mono>
                    <span class="block w-3 h-px bg-foreground/15" />
                    <span class="inline-flex items-center px-2 py-0.5 border border-primary/35 bg-primary/15 rounded-sm">
                      <Mono class="text-primary">{item.impact}</Mono>
                    </span>
                  </div>
                  <h3 class="mt-3 text-white text-2xl tracking-tight">
                    {item.role}
                  </h3>
                  <p class="mt-1 text-muted-foreground text-sm">
                    <span class="text-foreground">{item.company}</span>
                    <span class="mx-2 text-foreground/15">·</span>
                    {item.where}
                  </p>
                </div>
                <span class="shrink-0 mt-2 w-7 h-7 inline-flex items-center justify-center border border-foreground/15 rounded-full text-muted-foreground transition-all duration-300 group-hover:border-primary/50 group-hover:text-primary group-open:rotate-90">
                  ›
                </span>
              </div>
              <p class="mt-4 text-foreground/80 text-base max-w-prose">
                {item.summary}
              </p>
            </summary>
            <div class="details-body">
              <div>
                <div class="px-7 pb-7">
                  <ul class="space-y-3 max-w-prose">
                    {
                      item.points.map((p) => (
                        <li class="flex gap-3 text-foreground/65 text-sm leading-relaxed">
                          <span class="text-primary mt-1 shrink-0">›</span>
                          <span>{p}</span>
                        </li>
                      ))
                    }
                  </ul>
                  <div class="mt-5 flex flex-wrap gap-x-3 gap-y-2">
                    {
                      item.stack.map((s) => (
                        <Mono class="text-muted-foreground px-2 py-1 border border-border rounded-sm">
                          {s}
                        </Mono>
                      ))
                    }
                  </div>
                </div>
              </div>
            </div>
          </details>
        </Reveal>
      ))
    }
  </div>
</section>
