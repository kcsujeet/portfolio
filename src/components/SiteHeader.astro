---
import { NAME } from "@/config/constants";

// Marked on inner pages that belong to a section (the blog is "writing");
// on the homepage the scroll-spy in MobileNav sets it.
type Props = { current?: string };
const { current } = Astro.props;

const LINKS = [
  { id: "about", label: "about" },
  { id: "work", label: "work" },
  { id: "projects", label: "projects" },
  { id: "writing", label: "writing" },
];

const LINK_CLASS =
  "tap underline-offset-4 decoration-1 hover:text-ink data-active:text-ink data-active:underline";
---

<header class="sticky top-0 z-10 border-b border-rule bg-paper/95 backdrop-blur-md">
  <!-- Phones: one slim row with the name; sections live in the floating
       pill (MobileNav). Wider screens: one row, as in the design. -->
  <div class="px-gutter mx-auto flex max-w-page flex-wrap items-center justify-between gap-x-8 py-3 md:py-5">
    <a href="/#top" class="tap font-semibold tracking-name">{NAME}</a>
    <nav
      aria-label="Primary"
      class="flex gap-x-6 text-label text-ink-3 max-md:hidden"
    >
      {
        LINKS.map((l) => (
          <a
            href={`/#${l.id}`}
            data-section-link={l.id}
            data-active={l.id === current ? "" : undefined}
            aria-current={l.id === current ? "page" : undefined}
            class={LINK_CLASS}
          >
            {l.label}
          </a>
        ))
      }
      <a href="/#contact" data-section-link="contact" class={`${LINK_CLASS} text-ink`}>
        contact →
      </a>
    </nav>
  </div>
</header>
