---
// Floating icon pill for phones. Its script also drives the header nav. Icons are Lucide paths (https://lucide.dev),
// viewBox 24, currentColor stroke. On the homepage a scroll-spy marks the
// section in view; on inner pages the matching section is marked by prop.
type Props = { current?: string };
const { current } = Astro.props;

const SECTIONS = [
  {
    id: "top",
    label: "Home",
    icon: `<path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>`,
  },
  {
    id: "about",
    label: "About",
    icon: `<circle cx="12" cy="7" r="4"/><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>`,
  },
  {
    id: "work",
    label: "Work",
    icon: `<path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/><rect width="20" height="14" x="2" y="6" rx="2"/>`,
  },
  {
    id: "projects",
    label: "Projects",
    icon: `<path d="m18 16 4-4-4-4"/><path d="m6 8-4 4 4 4"/><path d="m14.5 4-5 16"/>`,
  },
  {
    id: "writing",
    label: "Writing",
    icon: `<path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"/><path d="m15 5 4 4"/>`,
  },
  {
    id: "contact",
    label: "Contact",
    icon: `<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>`,
  },
];
---

<nav
  aria-label="Sections"
  class="fixed bottom-pill left-1/2 z-20 flex -translate-x-1/2 items-center gap-1 rounded-full border border-rule bg-paper/90 p-1 shadow-pill backdrop-blur-md md:hidden"
>
  {
    SECTIONS.map((s) => (
      <a
        href={`/#${s.id}`}
        data-section-link={s.id}
        data-active={s.id === current ? "" : undefined}
        aria-label={s.label}
        aria-current={s.id === current ? "page" : undefined}
        class="group inline-flex size-8 items-center justify-center rounded-full transition-colors duration-150 hover:no-underline data-active:bg-ink"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          class="size-4 text-ink-3 transition-colors group-hover:text-ink group-data-active:text-paper"
          set:html={s.icon}
        />
      </a>
    ))
  }
</nav>

<script>
  // Homepage only: follow the section in view, in both the header nav and
  // this pill. Inner pages keep the section marked by prop.
  const links = document.querySelectorAll<HTMLAnchorElement>(
    "[data-section-link]",
  );
  const ids = new Set(Array.from(links, (l) => l.dataset.sectionLink ?? ""));
  const sections = Array.from(ids)
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  if (sections.length > 1) {
    const setActive = (id: string) => {
      for (const l of links) {
        const on = l.dataset.sectionLink === id;
        l.toggleAttribute("data-active", on);
        if (on) l.setAttribute("aria-current", "location");
        else l.removeAttribute("aria-current");
      }
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) setActive(entry.target.id);
        }
      },
      { rootMargin: "-40% 0px -55% 0px" },
    );
    for (const s of sections) observer.observe(s);

    // The hero is short on tall phones; treat the very top as Home.
    const onScroll = () => {
      if (window.scrollY < 80) setActive("top");
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }
</script>
