---
import { BUILD_DATE, NAME } from "@/config/constants";

type Props = { tone?: "light" | "inverse" };
const { tone = "light" } = Astro.props;

const year = BUILD_DATE.toLocaleString("en-US", {
  year: "numeric",
  timeZone: "America/Vancouver",
});
---

<footer
  class:list={[
    "border-t",
    tone === "inverse" ? "border-primary-foreground/15 text-primary-foreground/65" : "border-border text-muted-foreground",
  ]}
>
  <div class="px-gutter mx-auto flex max-w-page flex-wrap justify-between gap-x-6 gap-y-2 py-5 text-xs max-md:pb-pill-clear">
    <span>&copy; {year} {NAME}</span>
    <span>no trackers · no cookies · no fuss</span>
  </div>
</footer>
